            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{database}}\",\n            {{uid}},\n            \"{{password}}\",\n            \"library.book\",\n            \"create\",\n            [{\n                \"name\": \"El Principito\",\n                \"isbn\": \"9788478887194\"\n            }]\n        ]\n    },\n    \"id\": 4\n}"
            },
            "url": {
              "raw": "{{base_url}}/jsonrpc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
