        {
          "name": "Actualizar Libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Libro actualizado exitosamente\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.be.true;",
                  "    console.log(\"✅ Libro ID \" + pm.environment.get(\"last_book_id\") + \" actualizado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{database}}\",\n            {{uid}},\n            \"{{password}}\",\n            \"library.book\",\n            \"write\",\n            [\n                [{{last_book_id}}],\n                {\n                    \"isbn\": \"9788478887195\",\n                    \"sinopsis\": \"Una hermosa historia sobre un príncipe de otro planeta\"\n                }\n            ]\n        ]\n    },\n    \"id\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/jsonrpc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "description": "Actualiza el último libro creado. Cambia {{last_book_id}} por un ID específico si lo necesitas."
          },
          "response": []
        },
        {
          "name": "Eliminar Libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Libro eliminado exitosamente\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.be.true;",
                  "    console.log(\"🗑️  Libro ID \" + pm.environment.get(\"last_book_id\") + \" eliminado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{database}}\",\n            {{uid}},\n            \"{{password}}\",\n            \"library.book\",\n            \"unlink\",\n            [[{{last_book_id}}]]\n        ]\n    },\n    \"id\": 6\n}"
            },
            "url": {
              "raw": "{{base_url}}/jsonrpc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "description": "⚠️ CUIDADO: Elimina permanentemente el libro del sistema"
          },
          "response": []
        }
      ]
    },
