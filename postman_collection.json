{
  "info": {
    "name": "Library Management API - Odoo",
    "description": "Colección completa para probar la API de gestión de biblioteca Odoo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "library-management-api-001",
