  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Obtener UID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Autenticación exitosa\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.be.a('number');",
                  "    pm.expect(jsonData.result).to.be.above(0);",
                  "    ",
                  "    pm.environment.set(\"uid\", jsonData.result);",
                  "    console.log(\"✅ UID guardado: \" + jsonData.result);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"common\",\n        \"method\": \"authenticate\",\n        \"args\": [\n            \"{{database}}\",\n            \"{{username}}\",\n            \"{{password}}\",\n            {}\n        ]\n    },\n    \"id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/jsonrpc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "description": "Autentica al usuario y obtiene el UID necesario para todas las demás operaciones"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Libros - CRUD",
      "item": [
        {
          "name": "Listar Todos los Libros",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Se obtienen libros\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.be.an('array');",
                  "    console.log(\"📚 Total de libros: \" + jsonData.result.length);",
                  "    ",
                  "    if (jsonData.result.length > 0) {",
                  "        jsonData.result.forEach(book => {",
                  "            console.log(`  - ${book.name} (ID: ${book.id})`);",
                  "        });",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{database}}\",\n            {{uid}},\n            \"{{password}}\",\n            \"library.book\",\n            \"search_read\",\n            [[]],\n            {\n                \"fields\": [\"id\", \"name\", \"isbn\", \"availability\", \"author_ids\"],\n                \"limit\": 20\n            }\n        ]\n    },\n    \"id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/jsonrpc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "description": "Lista todos los libros disponibles en el sistema"
          },
          "response": []
        },
        {
          "name": "Buscar Libros por Nombre",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Búsqueda exitosa\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.be.an('array');",
                  "    ",
                  "    if (jsonData.result.length > 0) {",
                  "        console.log(\"🔍 Libros encontrados:\");",
                  "        jsonData.result.forEach(book => {",
                  "            console.log(`  - ${book.name} (ID: ${book.id})`);",
                  "        });",
                  "    } else {",
                  "        console.log(\"❌ No se encontraron libros con ese criterio\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{database}}\",\n            {{uid}},\n            \"{{password}}\",\n            \"library.book\",\n            \"search_read\",\n            [[[\"name\", \"ilike\", \"Quijote\"]]],\n            {\n                \"fields\": [\"id\", \"name\", \"isbn\", \"availability\"]\n            }\n        ]\n    },\n    \"id\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/jsonrpc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "description": "Busca libros que contengan 'Quijote' en su nombre. Cambia el valor para buscar otros libros."
          },
          "response": []
        },
