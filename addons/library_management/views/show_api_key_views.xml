<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_show_api_key_wizard_form" model="ir.ui.view">

        <field name="name">library.show.api.key.form</field>
        <field name="model">library.show.api.key</field>
        <field name="arch" type="xml">
            <form string="Nueva Clave API">
                <sheet>
                    <h3 class="fw-bold">Copia tu nueva clave</h3>
                    <p>
                        Usa esta clave para integraciones externas. Guárdala en un lugar seguro.
                    </p>
                    <group>
                        <field name="key" readonly="1" widget="copy_clipboard"/>
                    </group>
                    <footer>
                        <button string="Cerrar" class="btn-primary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

