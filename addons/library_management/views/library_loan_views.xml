<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo préstamo
            </p><p>
                Registra la salida y entrada de libros para los miembros.
            </p>
        </field>
    </record>

    <record id="view_library_loan_tree" model="ir.ui.view">
        <field name="name">library.loan.tree</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list string="Préstamos" decoration-warning="state == 'active'" decoration-danger="state == 'overdue'" decoration-muted="state == 'returned'">
                <field name="book_id"/>
                <field name="member_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form string="Préstamo">
                <header>
                    <button name="action_loan" string="Confirmar Préstamo" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return" string="Registrar Devolución" type="object" class="oe_highlight" invisible="state not in ['active', 'overdue']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,returned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="copy_id" domain="[('state', '=', 'available')]"/>
                            <field name="book_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="loan_date"/>
                            <field name="due_date"/>
                            <field name="return_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>